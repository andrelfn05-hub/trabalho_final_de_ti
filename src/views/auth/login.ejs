<%- include('../layouts/header') %>

<div style="display: flex; gap: 30px; justify-content: center; flex-wrap: wrap;">
  <div class="form-card" style="flex: 1; min-width: 300px;">
    <h2>Entrar</h2>
    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email">E-mail:</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group">
        <label for="senha">Senha:</label>
        <input type="password" id="senha" name="password" required>
      </div>
      <button type="submit" class="btn-primary" style="width: 100%;">Entrar</button>
    </form>
  </div>

  <div class="form-card" style="flex: 1; min-width: 300px;">
    <h2>Criar Conta</h2>
    <form action="/register" method="POST">
      <div class="form-group">
        <label for="reg-nome">Nome:</label>
        <input type="text" id="reg-nome" name="name" required>
      </div>
      <div class="form-group">
        <label for="reg-email">E-mail:</label>
        <input type="email" id="reg-email" name="email" required>
      </div>
      <div class="form-group">
        <label for="reg-senha">Senha:</label>
        <input type="password" id="reg-senha" name="password" required>
      </div>
      <div class="form-group">
        <label for="reg-confirm">Confirmar Senha:</label>
        <input type="password" id="reg-confirm" name="confirmPassword" required>
      </div>
      <button type="submit" class="btn-primary" style="width: 100%;">Cadastrar</button>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>