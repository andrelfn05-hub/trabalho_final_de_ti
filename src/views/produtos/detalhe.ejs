<%- include('../layouts/header') %>
<%- include('../layouts/menu') %>

<div class="detalhes-container">
  <h2><%= produto.nome %></h2>
  
  <div style="display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap;">
    <img src="<%= produto.imagemUrl || '/uploads/default.jpg' %>" alt="<%= produto.nome %>" style="width: 250px; border-radius: 8px; object-fit: cover;">
    <div>
      <p><strong>Categoria:</strong> <%= produto.categoria %></p>
      <p><strong>Descrição:</strong> <%= produto.descricao || 'Sem descrição cadastrada.' %></p>
      <a href="/produtos" class="btn-secondary">Voltar</a>
    </div>
  </div>

  <h3>Preços nas Lojas Parceiras</h3>
  
  <table style="width: 100%; border-collapse: collapse; margin-top: 15px; background: white; border-radius: 8px; overflow: hidden;">
    <thead>
      <tr style="background: #2c3e50; color: white; text-align: left;">
        <th style="padding: 12px;">Loja Parceira</th>
        <th style="padding: 12px;">Preço</th>
        <th style="padding: 12px;">Ação</th>
      </tr>
    </thead>
    <tbody>
      <% if (produto.ofertas && produto.ofertas.length > 0) { %>
        <% produto.ofertas.forEach(oferta => { %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 12px;"><%= oferta.loja %></td>
            <td style="padding: 12px;"><strong style="color: #27ae60;">R$ <%= oferta.preco %></strong></td>
            <td style="padding: 12px;">
              <a href="<%= oferta.link %>" target="_blank" class="btn-primary">Acessar Loja</a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="3" style="padding: 12px; text-align: center;">Nenhuma oferta encontrada para este produto.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../layouts/footer') %>