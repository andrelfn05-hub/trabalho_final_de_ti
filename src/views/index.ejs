<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casas Potiguar</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('layouts/header') %>

    <%- include('layouts/menu') %>


    <main class="container">

        <h2>Bem-vindo à Casas Potiguar</h2>

        <p>
            Encontre móveis para deixar sua casa mais confortável.
        </p>

        <section class="produtos">

          <div class="card">
      
              <img src="/img/sofa.jpg" alt="Sofá Moderno">
      
              <h3>Sofá Moderno</h3>
      
              <p>Conforto e qualidade para sua sala.</p>
      
              <button class="btn-comprar">Ver produto</button>
      
          </div>
      
      
      
          <div class="card">
      
              <img src="/img/mesa.jpg" alt="Mesa de Jantar">
      
              <h3>Mesa de Jantar</h3>
      
              <p>Design elegante para sua casa.</p>
      
              <button class="btn-comprar">Ver produto</button>
      
          </div>
      
      
      
          <div class="card">
      
              <img src="/img/guarda-roupa.jpg" alt="Guarda-Roupa">
      
              <h3>Guarda-Roupa</h3>
      
              <p>Mais organização para seu quarto.</p>
      
              <button class="btn-comprar">Ver produto</button>
      
          </div>
      
      </section>


    </main>


    <%- include('layouts/footer') %>

    <script src="/js/main.js"></script>
    <script src="/js/produtos.js"></script>

</body>
</html>