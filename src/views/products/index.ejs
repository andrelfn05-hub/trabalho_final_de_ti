<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos - Casas Potiguar</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../layouts/header') %>
    <%- include('../layouts/menu') %>

    <main class="container">

        <h1 class="titulo-pagina">Nossos Produtos</h1>

        <p class="subtitulo">
            Confira nossas melhores ofertas para sua casa.
        </p>

        <section class="produtos">

            <!-- SOFÁ -->

            <div class="card">

                <img src="/img/sofa.jpg" alt="Sofá">

                <span class="categoria">Sala</span>

                <h3>Sofá Moderno 3 Lugares</h3>

                <p class="preco-antigo">R$ 2.799,90</p>

                <h2 class="preco">R$ 2.299,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

            <!-- MESA -->

            <div class="card">

                <img src="/img/mesa.jpg" alt="Mesa">

                <span class="categoria">Cozinha</span>

                <h3>Mesa de Jantar 6 Lugares</h3>

                <p class="preco-antigo">R$ 1.799,90</p>

                <h2 class="preco">R$ 1.399,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

            <!-- GUARDA ROUPA -->

            <div class="card">

                <img src="/img/guarda-roupas.jpg" alt="Guarda Roupa">

                <span class="categoria">Quarto</span>

                <h3>Guarda-Roupa Casal</h3>

                <p class="preco-antigo">R$ 2.499,90</p>

                <h2 class="preco">R$ 1.999,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

            <!-- CAMA -->

            <div class="card">

                <img src="/img/cama.jpg" alt="Cama">

                <span class="categoria">Quarto</span>

                <h3>Cama Box Queen</h3>

                <p class="preco-antigo">R$ 2.299,90</p>

                <h2 class="preco">R$ 1.899,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

            <!-- RACK -->

            <div class="card">

                <img src="/img/rack.jpg" alt="Rack">

                <span class="categoria">Sala</span>

                <h3>Rack para TV</h3>

                <p class="preco-antigo">R$ 999,90</p>

                <h2 class="preco">R$ 799,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

            <!-- CÔMODA -->

            <div class="card">

                <img src="/img/comoda.jpg" alt="Cômoda">

                <span class="categoria">Quarto</span>

                <h3>Cômoda 5 Gavetas</h3>

                <p class="preco-antigo">R$ 899,90</p>

                <h2 class="preco">R$ 699,90</h2>

                <button class="btn-comprar">Ver Produto</button>

            </div>

        </section>

    </main>

    <%- include('../layouts/footer') %>

    <script src="/js/produtos.js"></script>

</body>

</html>